# Orakel — Environment Variables Template
# Copy to .env and fill in your values: `cp .env.example .env`

# =============================================================================
# WarcraftLogs API (REQUIRED for WCL data ingestion)
# Get credentials at: https://www.warcraftlogs.com/api/clients/
# =============================================================================
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
WCL_TOKEN_URL=https://www.warcraftlogs.com/oauth/token
WCL_API_URL=https://www.warcraftlogs.com/api/v2/client

# =============================================================================
# Raider.IO API (OPTIONAL — public API works without key for most endpoints)
# Get a key at: https://raider.io/api
# =============================================================================
RAIDERIO_API_KEY=
RAIDERIO_BASE_URL=https://raider.io/api/v1

# =============================================================================
# MinIO (S3-compatible local storage)
# Defaults match the docker-compose.yml setup
# =============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=orakel
MINIO_SECRET_KEY=orakel123
MINIO_BUCKET=orakel
MINIO_SECURE=false

# =============================================================================
# Season configuration
# TWW S3 is the default for the Orakel MVP
# =============================================================================
SEASON=season-tww-3

# =============================================================================
# MLflow tracking
# File-based local tracking by default; change to remote URI for production
# =============================================================================
MLFLOW_TRACKING_URI=file:./mlruns
